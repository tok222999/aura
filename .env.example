# AURA Testnet Demo Relayer / Payer Configuration
# Server-side environment template. Copy to .env.local and configure your own keys.
# NEVER commit .env.local to version control or expose private keys in public repositories.

DEMO_WALLET_ADDRESS=0x9CAF6275fe5e9F833818D1a76A09d9c067C19033
DEMO_WALLET_BASE_PRIVATE_KEY=your_base_sepolia_private_key_here
DEMO_WALLET_SOLANA_PRIVATE_KEY=your_solana_devnet_base58_private_key_here
# Optional durable demo payout recipient. If unset, Aura generates and persists
# a separate recoverable recipient under AURA_DATA_DIR (never the relayer key).
# DEMO_WALLET_SOLANA_RECIPIENT_PRIVATE_KEY=

# Keep this directory on durable storage when changing ports, workers, or hosts.
AURA_DATA_DIR=./.aura-data
# Zcash Testnet helper and durable wallet database. On Linux/macOS use the
# binary without .exe; keep the wallet directory on the same durable volume.
ZCASH_DEVTOOL_PATH=./zcash-devtool/target/release/zcash-devtool.exe
ZCASH_WALLET_DIR=./zcash-wallet-data
ZCASH_SERVER=zecrocks
# Optional comma-separated read/sync fallbacks, for example host:port values.
# ZCASH_SERVER_FALLBACKS=lwd.testnet.zec.pro:443
# Hosted deployments must use absolute mounted paths and enable this gate.
# AURA_REQUIRE_DURABLE_RUNTIME=1
# Hosted Next.js builds may set NODE_ENV=production while still running the
# public hackathon demo. Opt into the real production boundary explicitly.
AURA_RUNTIME_MODE=hackathon-testnet
# Optional production minimization policy. When set, terminal transaction
# metadata and expired request records older than this many days are pruned.
# Keep this disabled for the jury demo if full explorer proof is needed.
# Required when AURA_RUNTIME_MODE=production. Terminal records are redacted after this many days.
# AURA_DATA_RETENTION_DAYS=30

# Production-only transactional quote/outbox database. The adapter uses
# Node 24's built-in SQLite and is never selected by the hackathon demo.
# AURA_PRODUCTION_DB_PATH=./.aura-production/aura.sqlite

BASE_SEPOLIA_RPC=https://sepolia.base.org
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# Optional comma-separated RPC fallbacks used for reads, broadcasts, and confirmation checks.
# BASE_SEPOLIA_RPC_FALLBACKS=https://base-sepolia-rpc.publicnode.com
# SOLANA_DEVNET_RPC_FALLBACKS=https://api.devnet.solana.com
VAULT_DEPOSIT_ADDRESS=0x84bE03816773229bBcE6e422D7702f23fD6Ec10e
# Optional receiving-address override. Leave unset to use the address derived
# from DEMO_WALLET_SOLANA_PRIVATE_KEY (or the persisted demo relayer key).
# SOLANA_VAULT_ADDRESS=
BASE_SEPOLIA_USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Required on hosted deployments (including hackathon-testnet). Localhost can
# bootstrap without it. The matching capability is never stored in browser
# code; it is exchanged for an HttpOnly jury session.
# AURA_DEMO_JURY_CAPABILITY=
# AURA_TRUST_PROXY=false
# Zcash confirmations required before an irreversible destination payout.
ZCASH_SETTLEMENT_SAFETY_CONFIRMATIONS=2
# Set true only for an explicitly local, non-production jury bootstrap.
AURA_DEMO_LOCAL_BOOTSTRAP=false
# Comma-separated pool of explicitly provisioned funded tenant records backed
# by AURA-operated pre-funded Zcash inventory. Each active jury session
# receives one tenant lease; balances and spend authorization stay tenant-scoped.
# Every tenant must already have durable recovery/spend records and real
# testnet balance. Keep AURA_JURY_TENANT_ID only for legacy single-tenant mode.
# AURA_JURY_TENANT_IDS=vault_r_replace_1,vault_r_replace_2,vault_r_replace_3
# Jury tenant lease in minutes; bounded by the server to 30–60 minutes.
# AURA_JURY_SESSION_TTL_MINUTES=45
# AURA_JURY_TENANT_ID=vault_r_replace_with_provisioned_tenant
# Private operator launch gate: the exact deployed origin and judge invite.
# AURA_OPERATOR_BASE_URL=https://jury.example.com
# AURA_JURY_DEMO_URL=https://jury.example.com/balance?tour=1
